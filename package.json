{
  "name": "model-architecture-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "主流的模型 架构全解析",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:head-flow": "playwright test e2e/head-flow.spec.ts",
    "check": "pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write src tests e2e",
    "format:check": "prettier --check src tests e2e"
  },
  "dependencies": {
    "@xyflow/react": "12.9.3",
    "katex": "0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "lucide-react": "0.475.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.20.1",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitest": "3.2.3",
    "jsdom": "23.2.0",
    "@playwright/test": "1.61.1",
    "prettier": "3.6.2"
  }
}
